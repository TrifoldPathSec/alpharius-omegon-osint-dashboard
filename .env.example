# Copy to .env and fill in what you have. Everything is optional.

# Where the SQLite database lives (default: data/alpharius.db)
# ALPHARIUS_DB=data/alpharius.db

# Flask session key. Leave blank to generate a random one at each start.
FLASK_SECRET_KEY=

# abuse.ch Auth-Key (https://auth.abuse.ch). Bulk exports currently work without it.
ABUSECH_AUTH_KEY=

# Enrichment services. Each is skipped when its key is empty.
IPINFO_TOKEN=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Wazuh indexer, for match-alerts / match-vulns --indexer.
# Use a read-only indexer user. Point VERIFY at the root-ca.pem from your
# wazuh-docker certs folder, or set it to false for a self-signed lab only.
WAZUH_INDEXER_URL=https://<wazuh-host>:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_VERIFY=config/root-ca.pem
